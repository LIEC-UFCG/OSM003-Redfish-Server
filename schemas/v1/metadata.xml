<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <!-- Referências externas -->
  <edmx:Reference Uri="/schemas/v1/RedfishExtensions_v1.xml">
    <edmx:Include Namespace="RedfishExtensions.v1_0_0" Alias="Redfish"/>
  </edmx:Reference>
  <edmx:Reference Uri="/schemas/v1/Resource_v1.xml">
    <edmx:Include Namespace="Resource" Alias="Resource"/>
  </edmx:Reference>
  <edmx:Reference Uri="/schemas/v1/SessionCollection_v1.xml">
    <edmx:Include Namespace="SessionCollection" Alias="SessionCollection"/>
  </edmx:Reference>
  <edmx:Reference Uri="/schemas/v1/Session_v1.xml">
    <edmx:Include Namespace="Session" Alias="Session"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/LogEntryCollection_v1.xml">
    <edmx:Include Namespace="LogEntryCollection" Alias="LogEntryCollection"/>
  </edmx:Reference>
  <!-- Standard Redfish schema references used by the Service EntityContainer -->
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/AccountService_v1.xml">
    <edmx:Include Namespace="AccountService"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Manager_v1.xml">
    <edmx:Include Namespace="Manager"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/Chassis_v1.xml">
    <edmx:Include Namespace="Chassis"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/ComputerSystem_v1.xml">
    <edmx:Include Namespace="ComputerSystem"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/EventService_v1.xml">
    <edmx:Include Namespace="EventService"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/UpdateService_v1.xml">
    <edmx:Include Namespace="UpdateService"/>
  </edmx:Reference>
  <edmx:Reference Uri="http://redfish.dmtf.org/schemas/v1/JsonSchemas_v1.xml">
    <edmx:Include Namespace="JsonSchemas"/>
  </edmx:Reference>


  <!-- Serviços de Dados -->
  <edmx:DataServices>
    <!-- Definição do SessionService -->
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SessionService">
      <EntityType Name="SessionService">
        <Annotation Term="Redfish.Required"/>
        <Property Name="ServiceEnabled" Type="Edm.Boolean" Nullable="false"/>
        <Property Name="SessionTimeout" Type="Edm.Int32" Nullable="false"/>
        <NavigationProperty Name="Sessions" Type="SessionCollection.v1_8_0.SessionCollection" Nullable="false"/>
      </EntityType>
    </Schema>

    <!-- Definição do SessionCollection -->
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="SessionCollection.v1_8_0">
      <EntityType Name="SessionCollection" BaseType="Resource.ResourceCollection">
        <Annotation Term="Redfish.Required"/>
        <NavigationProperty Name="Members" Type="Collection(Session.Session)" Nullable="false"/>
      </EntityType>
    </Schema>

    <!-- Definição do Session -->
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="Session">
      <EntityType Name="Session">
        <Annotation Term="Redfish.Required"/>
        <Property Name="Id" Type="Edm.String" Nullable="false"/>
        <Property Name="Name" Type="Edm.String"/>
        <Property Name="Description" Type="Edm.String"/>
        <Property Name="UserName" Type="Edm.String"/>
      </EntityType>
    </Schema>

    <!-- Root Service schema with EntityContainer (defines top-level resources) -->
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="Service" xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
      <EntityContainer Name="EntityContainer" m:IsDefaultEntityContainer="true">
        <EntitySet Name="ServiceRoot" EntityType="Resource.Resource"/>
        <EntitySet Name="AccountService" EntityType="AccountService.AccountService"/>
        <EntitySet Name="Managers" EntityType="Manager.Manager"/>
        <EntitySet Name="Chassis" EntityType="Chassis.Chassis"/>
        <EntitySet Name="Systems" EntityType="ComputerSystem.ComputerSystem"/>
        <EntitySet Name="EventService" EntityType="EventService.EventService"/>
        <EntitySet Name="UpdateService" EntityType="UpdateService.UpdateService"/>
        <EntitySet Name="SessionService" EntityType="SessionService.SessionService"/>
        <EntitySet Name="JsonSchemas" EntityType="JsonSchemas.JsonSchemaFile"/>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
